<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">PortalCopa26</a>
    </div>
</div>

<input type="checkbox" title="Menu de navegação" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @foreach (var item in Itens)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@item.Href" Match="@(item.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    <span class="bi @item.Icone" aria-hidden="true"></span> @item.Texto
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private sealed record ItemMenu(string Href, string Texto, string Icone);

    private static readonly ItemMenu[] Itens =
    [
        new("", "Home", "bi-house-door-fill-nav-menu"),
        new("jogos", "Jogos", "bi-list-nested-nav-menu"),
        new("grupos", "Grupos", "bi-list-nested-nav-menu"),
        new("selecoes", "Seleções", "bi-list-nested-nav-menu"),
        new("ranking", "Ranking", "bi-list-nested-nav-menu"),
        new("simulador", "Simulador", "bi-plus-square-fill-nav-menu"),
    ];
}
